# ---------------------------------------------------------------------------
# Nude Image Detector - variables de entorno (prefijo NID_)
# Copia este archivo a `.env` y ajusta lo que necesites.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
NID_HOST=0.0.0.0
NID_PORT=8000
NID_DEBUG=false
NID_LOG_LEVEL=INFO
# true = una línea JSON por evento (agregadores); false = texto legible (local)
NID_LOG_JSON=true
# Nº de proxies de confianza delante de la app para interpretar X-Forwarded-For
NID_TRUSTED_PROXY_COUNT=0

# --- Motor de detección -----------------------------------------------------
# nudenet = modelo ONNX real (por defecto) | mock = siempre "allow" (solo pruebas)
# disabled = la API responde 503 en /v1/analyze
NID_ENGINE=nudenet
# Ruta a un .onnx propio; vacío = usa el modelo incluido en el wheel de nudenet
NID_MODEL_PATH=
NID_INFERENCE_RESOLUTION=320
# Confianza mínima para que una detección puntúe (el modelo nunca baja de 0.20)
NID_MIN_CONFIDENCE=0.30
# Inferencias simultáneas por proceso (semáforo); ajústalo a tus CPUs
NID_MAX_CONCURRENT_INFERENCES=2
NID_LOAD_MODEL_AT_STARTUP=true
NID_WARMUP=true
# Fotogramas muestreados de GIF/WebP animados (un GIF puede esconder frames explícitos)
NID_MAX_FRAMES=3

# --- Política de moderación -------------------------------------------------
# strict | balanced | lenient
NID_STRICTNESS=balanced
# Sobrescrituras finas (déjalas vacías para usar los valores del perfil)
NID_BLOCK_THRESHOLD=
NID_REVIEW_THRESHOLD=
NID_SUGGESTIVE_FACTOR=
# Ajuste por etiqueta, p.ej. tolerar torso masculino y ser estricto con glúteos:
# NID_LABEL_WEIGHTS={"MALE_BREAST_EXPOSED":0.0,"BUTTOCKS_EXPOSED":1.0}
NID_LABEL_WEIGHTS=
# Permite que cada petición cambie perfil/umbrales con query params
NID_ALLOW_REQUEST_OVERRIDES=true

# --- Límites de subida ------------------------------------------------------
NID_MAX_CONTENT_LENGTH=10485760
NID_MAX_IMAGE_PIXELS=40000000
NID_MAX_ANALYSIS_PIXELS=4000000
NID_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff

# --- Autenticación y abuso --------------------------------------------------
# Separadas por comas. En cuanto defines una clave, la API la exige (salvo /health, /ready y la doc).
NID_API_KEYS=
NID_RATE_LIMIT_ENABLED=false
NID_RATE_LIMIT_REQUESTS=120
NID_RATE_LIMIT_WINDOW_SECONDS=60

# --- Descarga de imágenes por URL (superficie SSRF) --------------------------
NID_FETCH_ENABLED=true
NID_FETCH_TIMEOUT_SECONDS=8
NID_FETCH_MAX_BYTES=10485760
NID_FETCH_MAX_REDIRECTS=3
# SOLO para pruebas locales: permite localhost/127.0.0.1/redes privadas
NID_FETCH_ALLOW_PRIVATE_NETWORKS=false
# Allowlist (vacío = cualquier host público). Acepta subdominios con ".dominio"
NID_FETCH_ALLOWED_HOSTS=
NID_FETCH_BLOCKED_HOSTS=
NID_FETCH_BLOCKED_CIDRS=169.254.169.254/32,100.64.0.0/10,192.0.0.0/24,198.18.0.0/15
NID_FETCH_ALLOWED_PORTS=80,443
NID_FETCH_USER_AGENT=nude-image-detector/1.0

# --- Caché ------------------------------------------------------------------
# Guarda detecciones por SHA-256 de la imagen (no veredictos, para poder
# re-puntuar con otra estrictez sin volver a ejecutar el modelo)
NID_CACHE_ENABLED=true
NID_CACHE_MAXSIZE=512
NID_CACHE_TTL_SECONDS=3600

# --- Lotes ------------------------------------------------------------------
NID_BATCH_MAX_ITEMS=10

# --- Varios -----------------------------------------------------------------
# "*" para permitir cualquier origen desde el navegador; pon tu dominio en producción
NID_CORS_ORIGIN=*
NID_SERVICE_NAME=nude-image-detector
NID_VERSION=1.0.0

# --- Gunicorn (opcional) ----------------------------------------------------
# NID_GUNICORN_WORKERS=2
# NID_GUNICORN_THREADS=4
# NID_GUNICORN_TIMEOUT=60
